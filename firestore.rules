rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's own profile: readable/writable only by that signed-in
    // user. Demo-scoped rule — a real deployment would add role-based
    // write restrictions (e.g. only admins can change `role`).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
